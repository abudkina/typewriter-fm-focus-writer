{
  "name": "typewriter-fm-focus-writer",
  "version": "1.0.0",
  "description": "Минималистичный текстовый редактор для глубокой работы со звуком печатной машинки",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "screenshots": "node scripts/capture-screens.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/howler": "^2.2.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
